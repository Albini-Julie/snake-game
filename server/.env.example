# Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mistral AI
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_URL=https://api.mistral.ai/v1/chat/completions

# Serveur
PORT=3000
CLIENT_URL=http://localhost:5173

# Configuration jeu
# Vitesse du snake en mode multijoueur (ms entre chaque tick, plus petit = plus rapide)
GAME_SPEED_MS=150
# Score maximum théorique par seconde, utilisé pour la détection anti-triche
MAX_SCORE_PER_SECOND=2

# Configuration IA
# Durée du cache des pseudos générés (ms)
AI_USERNAMES_CACHE_TTL_MS=300000
# Fenêtre de rate limiting pour les routes IA (ms)
AI_RATE_LIMIT_WINDOW_MS=60000
# Nombre max de requêtes /ai/usernames et /ai/advice par fenêtre
AI_RATE_LIMIT_MAX=10
# Nombre max de requêtes /ai/demo-move par fenêtre (plus permissif, appelé en temps réel)
AI_DEMO_RATE_LIMIT_MAX=60
